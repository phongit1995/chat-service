# Docker Images
DOCKERHUB_USERNAME=phongit1995
API_VERSION=latest
CHAT_VERSION=latest
MIGRATE_VERSION=latest
WEB_VERSION=latest

# Ports
API_PORT=5444
WEB_PORT=5445

# Database Configuration (using docker-compose defaults)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chat_server
DB_USER=postgres
DB_PASSWORD=postgres123
DB_SSL_MODE=disable

# Redis Configuration (using docker-compose defaults)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# WebSocket Redis (using docker-compose defaults)
WEBSOCKET_REDIS_HOST=redis
WEBSOCKET_REDIS_PORT=6379
WEBSOCKET_REDIS_PASSWORD=redis123
WEBSOCKET_REDIS_DB=1

# ScyllaDB Configuration (using docker-compose defaults)
SCYLLA_HOST=scylladb
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=chat_server
SCYLLA_CONSISTENCY=QUORUM
SCYLLA_CQL_PORT=9042
SCYLLA_THRIFT_PORT=9160
SCYLLA_API_PORT=10000

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=release

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRY=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://chat-server-web.ola-server.click,https://chat-server-api.ola-server.click

# WebSocket Configuration
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024

# Swagger Configuration
SWAGGER_HOST=chat-server-api.ola-server.click

# Kafka Configuration (using docker-compose defaults)
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=chat-server-consumers
KAFKA_TOPIC_MESSAGE_CREATED=chat.message.created
KAFKA_TOPIC_MESSAGE_DELETED=chat.message.deleted
KAFKA_TOPIC_CONVERSATION_UPDATED=chat.conversation.updated
KAFKA_PORT=9092

# PostgreSQL Port (for docker-compose)
POSTGRES_PORT=5432

# Web Frontend Configuration
VITE_API_BASE_URL=https://chat-server-api.ola-server.click